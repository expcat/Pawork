    {"name": "http_502", "kind": "http_error", "status": 502, "error_kind": "ProviderUnavailable", "description": "HTTP 502 → ProviderUnavailable"},
    {"name": "http_503", "kind": "http_error", "status": 503, "error_kind": "ProviderUnavailable", "description": "HTTP 503 → ProviderUnavailable"},
    {"name": "http_504", "kind": "http_error", "status": 504, "error_kind": "ProviderUnavailable", "description": "HTTP 504 → ProviderUnavailable"},
    {"name": "responses_error_chatgpt_quota", "kind": "sse", "transports": ["responses"], "fixture": "responses_error_chatgpt_quota.sse", "needle": "usage limit", "description": "Responses 流内 error 事件，message 含 usage+limit（chatgpt needle → QuotaExceeded）"},
    {"name": "responses_error_xai_quota", "kind": "sse", "transports": ["responses"], "fixture": "responses_error_xai_quota.sse", "needle": "insufficient_quota", "description": "Responses 流内 response.failed 事件，message 含 insufficient_quota（xai needle → QuotaExceeded）"},
    {"name": "responses_error_go_quota", "kind": "sse", "transports": ["responses"], "fixture": "responses_error_go_quota.sse", "needle": "opencode-go responses quota", "description": "opencode-go Responses 组 response.failed，message 原文透传（无专属 needle 规则）"},
    {"name": "slow_stream", "kind": "slow", "interval_ms": 1000, "description": "任意 transport 的正常流按 interval_ms 定速（query interval_ms 可覆盖），用于 30s 心跳与读超时重置测试"},
    {"name": "truncated_chat", "kind": "sse", "transports": ["chat"], "fixture": "truncated_chat.sse", "description": "Chat 流既无 finish_reason 也无 [DONE] → StreamInterrupted"},
