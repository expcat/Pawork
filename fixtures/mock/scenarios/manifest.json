{
  "comment": "MOCK-4 场景库。触发方式：请求体任意文本含 MOCK:<NAME 大写>（如 MOCK:RATE_LIMIT，优先级高），或 POST /__control body {'scenario':'<name>'} 切全局场景（{'scenario':null} 或重启复位）。kind=http_error 在全部 persona 端点生效（§2.5：只发状态码 + 可选 Retry-After，错误体不参与解析）；kind=sse 仅作用于 transports 内的对话端点；kind=slow 复用通道正常流（fixture 命中优先，否则兜底），按 interval_ms 定速，query 参数 interval_ms 可覆盖（0-60000ms）。",
  "scenarios": [
    {"name": "http_400", "kind": "http_error", "status": 400, "error_kind": "InvalidRequest", "description": "HTTP 400 → InvalidRequest"},
    {"name": "http_401", "kind": "http_error", "status": 401, "error_kind": "Authentication", "description": "HTTP 401 → Authentication"},
    {"name": "http_402", "kind": "http_error", "status": 402, "error_kind": "QuotaExceeded", "description": "HTTP 402 → QuotaExceeded"},
    {"name": "http_403", "kind": "http_error", "status": 403, "error_kind": "Authorization", "description": "HTTP 403 → Authorization"},
    {"name": "http_404", "kind": "http_error", "status": 404, "error_kind": "ModelNotFound", "description": "HTTP 404 → ModelNotFound"},
    {"name": "http_408", "kind": "http_error", "status": 408, "error_kind": "Timeout", "description": "HTTP 408 → Timeout"},
    {"name": "http_413", "kind": "http_error", "status": 413, "error_kind": "ContextTooLarge", "description": "HTTP 413 → ContextTooLarge"},
    {"name": "rate_limit", "kind": "http_error", "status": 429, "retry_after": "30", "error_kind": "RateLimited", "description": "HTTP 429 + Retry-After 整数秒形态"},
    {"name": "rate_limit_date", "kind": "http_error", "status": 429, "retry_after": "Fri, 01 Jan 2027 00:00:00 GMT", "error_kind": "RateLimited", "description": "HTTP 429 + Retry-After IMF-fixdate 形态"},
    {"name": "http_451", "kind": "http_error", "status": 451, "error_kind": "ContentFiltered", "description": "HTTP 451 → ContentFiltered"},
